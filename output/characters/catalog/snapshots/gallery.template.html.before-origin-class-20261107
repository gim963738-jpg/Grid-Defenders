:root{color-scheme:light;--page:#f4f1eb;--paper:#fff;--ink:#292d30;--muted:#6a706f;--line:#dddcd4;--accent:#315d68;--tint:#eaf1ef;--stage:#faf9f5}*{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--ink);font:14px/1.65 "Segoe UI","Malgun Gothic",sans-serif}button,input,select{font:inherit;min-height:44px}button{cursor:pointer}a{color:var(--accent);text-underline-offset:3px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #bc792c;outline-offset:3px}button{color:var(--ink);border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:7px 12px}button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}header{padding:26px 28px 22px;border-bottom:1px solid var(--line)}.eyebrow{color:var(--accent);font-size:11px;letter-spacing:1.5px;font-weight:700}h1{font-size:clamp(25px,3.2vw,36px);line-height:1.3;margin:4px 0 9px;letter-spacing:-.7px}h2{font-size:17px;margin:0}p{margin:6px 0}.muted{color:var(--muted)}.links{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:15px;font-size:13px}.stats{display:flex;gap:10px 25px;flex-wrap:wrap;margin:16px 0 0}.stats strong{font-size:22px;margin-right:5px;color:var(--accent)}.stats span{font-size:12px;color:var(--muted)}.layout{display:grid;grid-template-columns:235px minmax(0,1fr);gap:24px;max-width:1800px;padding:24px 28px 40px;margin:auto}aside{align-self:start;position:sticky;top:16px}.side-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.side-title small{color:var(--muted);font-size:11px}#collection-list{display:flex;flex-direction:column;gap:6px}.collection-button{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;text-align:left;font-size:12px;min-height:46px}.collection-button .number{font-variant-numeric:tabular-nums;opacity:.75}main{min-width:0}.scope-tabs{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:15px}.scope-tabs button{font-size:13px}.