ng:4px 9px}.empty{border:1px dashed var(--line);border-radius:10px;padding:40px 20px;text-align:center;background:var(--paper);color:var(--muted)}.more{display:flex;justify-content:center;margin:24px 0}.more button{min-width:180px}.footer-note{border-top:1px solid var(--line);padding-top:17px;margin-top:22px;font-size:12px;color:var(--muted)}dialog{padding:0;border:0;border-radius:12px;max-width:calc(100vw - 24px);max-height:calc(100dvh - 24px);width:max-content;background:var(--paper);color:var(--ink)}dialog::backdrop{background:#122029dc}.viewer-bar{padding:10px 14px;display:flex;justify-content:space-between;align-items:center;gap:15px;max-width:1200px}.viewer-bar strong{font-size:14px}.viewer-buttons{display:flex;gap:7px;flex-shrink:0}.viewer-buttons button{min-height:38px;font-size:12px}.viewer-canvas{max-width:calc(100vw - 24px);max-height:calc(100dvh - 230px);overflow:auto;background:var(--stage)}#large{display:block;max-width:none;width:auto;height:auto}#large.fit{max-width:calc(100vw - 50px);max-height:calc(100dvh - 250px);object-fit:contain}.viewer-meta{padding:12px 15px;font-size:12px;max-width:1100px;max-height:150px;overflow:auto}.viewer-meta p{margin:2px 0;overflow-wrap:anywhere}.viewer-meta .links{margin-top:7px;gap:7px 17px}.viewer-meta details{margin-top:7px;font-size:11px}.viewer-meta summary{cursor:pointer}#alias-list{list-style:none;padding:0;margin:4px 0}.collection-select-label{margin-bottom:14px}#reset{font-size:12px;min-height:36px;padding:4px 11px}@media(min-width:1600px){.stage{height:340px}}@media(max-width:1150px){.layout{grid-template-columns:205px minmax(0,1fr);gap:18px}.filters{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stage{height:300px}}@media(max-width:800px){header{padding:22px 17px 18px}.layout{display:block;padding:17px 14px 30px}aside{display:none}.mobile-collection{display:flex}.filters{gap:10px}.grid{gap:12px}.stage{height:280px}.stats{gap:7px 17px}.scope-tabs{gap:6px}.scope-tabs button{font-size:12px;padding:6px 10px}.toolbar{padding:12px}.card-body{padding:11px}.card h2{font-size:13px}.description{font-size:11px}.viewer-bar{align-items:flex-start}.viewer-bar strong{max-width:55vw}.viewer-buttons button{padding:4px 8px}}@media(max-width:450px){.stage{height:220px;padding:4px}.grid{gap:9px}.filters{grid-template-columns:repeat(2,minmax(0,1fr))}.search-label{grid-column:1/-1}.filters label:last-child{grid-column:1/-1}.card-body{padding:10px}.card h2{font-size:12px}.backgrounds{width:100%;justify-content:flex-end}.stats strong{font-size:19px}.links{gap:7px 15px}.actions{gap:6px}.actions button{padding:4px 7px;font-size:11px}.badge{font-size:9px}.viewer-meta{font-size:11px}}
</style></head><body>
<header><div class="eyebrow">GRID DEFENDERS / CHARACTER LIBRARY</div><h1>캐릭터 제작 모음</h1><p class="muted">인계 자료와 이번 브랜치의 제작본을 캐릭터·묶음·방향·버전으로 찾아봅니다.</p><div class="stats" id="totals"></div><nav class="links"><a id="studioLink" href="http://127.0.0.1:8788/">이미지 제작 도구</a><a href="../../../문서/02_세부기획/02_영웅/캐릭터그림체/GC9_그림체기준.md">GC9 그림체 규칙</a><a href="../../../문서/02_세부기획/02_영웅/스플래시아트/SP13_배경구성규칙.md">SP13 배경 규칙</a><a href="../catalog/catalog.json">분류 목록 JSON</a><a href="../catalog/정리기준.md">정리 기준</a></nav></header>
<div class="layout"><aside><div class="side-title"><h2>제작 묶음</h2><small>전체 수량</small></div><div id="collection-list"></div></aside><main>
<nav class="scope-tabs" id="scope-tabs" aria-label="버전과 용도"></nav>
<div class="toolbar"><label class="mobile-collection collection-select-label">제작 묶음<select id="collection"></select></label><details id="filter-panel" open><summary>검색·캐릭터·방향 필터</summary><div class="filters"><label class="search-label">이름·파일·특징 검색<input id="query" type="search" placeholder="예: C4, 지팡이, 주인공, 금속" autocomplete="off"></label><label>캐릭터<select id="character"></select></label><label>방향·구도<select id="view"></select></label><label>정렬<select id="sort"><option value="collection">제작 묶음 순</option><option value="character">캐릭터 이름 순</option><option value="version">버전 높은 순</option></select></label></div></details></div>
<div class="result-bar"><div><div class="result-heading" id="result-heading"></div><div class="result-info" id="result-count" aria-live="polite"></div></div><div class="backgrounds"><button type="button" id="reset">필터 초기화</button><span>표시 배경</span><button type="button" data-background="#faf9f5" aria-pressed="true">밝게</button><button type="button" data-background="#161e27" aria-pressed="false">어둡게</button></div></div>
<div class="grid" id="gallery"></div><div class="empty" id="empty" hidden>해당 조건의 이미지가 없습니다. 버전·캐릭터·방향 조건을 바꿔 볼 수 있습니다.</div><div class="more"><button id="more" type="button">더 보기</button></div>
<p class="footer-note">최근 정리본은 작업별 버전과 선택 기록에 따른 분류입니다. C4 얼굴·전체 표현과 C3 금속은 사용자 피드백을 표시했습니다. 원본 참조와 이전 버전은 각 탭에 보존하며, 같은 이미지의 여러 경로는 상세 보기에서 확인할 수 있습니다. 미리보기와 원본 보기는 같은 파일을 사용합니다.</p>
</main></div>
<dialog id="viewer" aria-labelledby="viewer-title"><div class="viewer-bar"><strong id="viewer-title"></strong><div class="viewer-buttons"><button type="button" id="fit" aria-pressed="false">화면에 맞춤</button><button type="button" id="close">닫기</button></div></div><div class="viewer-canvas"><img id="large" alt=""></div><div class="viewer-meta"><p id="viewer-info"></p><p id="viewer-path" class="muted"></p><div class="links" id="viewer-links"></div><details id="aliases"><summary id="alias-summary"></summary><ul id="alias-list"></ul></details></div></dialog>
<script id="catalog-data" type="application/json">__CATALOG_DATA__</script>
<style>#filter-panel>summary{display:none}#filter-panel{margin:0}@media(max-width:800px){#filter-panel>summary{display:flex;align-items:center;min-height:44px;cursor:pointer;color:var(--accent);font-size:13px}#filter-panel[open]>.filters{margin-top:9px}.collection-select-label{margin-bottom:5px}}</style>
<script>
'use strict';
const catalog=JSON.parse(document.getElementById('catalog-data').textContent);
const assets=catalog.assets,collections=new Map(catalog.collections.map(c=>[c.id,c]));
const state={scope:'current',collection:'all',character:'all',view:'all',query:'',sort:'collection',limit:24};
const grid=document.getElementById('gallery'),viewer=document.getElementById('viewer');
const scopeNames={current:'최근 정리본',history:'이전 버전·초안',reference:'원본·그림체 참조',all:'전체'};
const byId=id=>document.getElementById(id);
if(location.protocol==='http:'||location.protocol==='https:')byId('studioLink').href=location.origin+'/';
const compactFilters=matchMedia('(max-width:800px)');byId('filter-panel').open=!compactFilters.matches;compactFilters.addEventListener('change',e=>{byId('filter-panel').open=!e.matches;});
const node=(tag,cls,text)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=text;return e;};
const scopeCount=s=>s==='all'?assets.length:assets.filter(a=>a.status===s).length;
for(const [id,label] of Object.entries(scopeNames)){const b=node('button','',`${label} · ${scopeCount(id)}`);b.type='button';b.dataset.scope=id;b.addEventListener('click',()=>{state.scope=id;state.limit=24;render();});byId('scope-tabs').append(b);}
function selectOption(select,value,label){const o=node('option','',label);o.value=value;select.append(o);}
selectOption(byId('collection'),'all','전체 제작 묶음');
for(const c of [{id:'all',label:'전체 제작 묶음'},...catalog.collections]){
 const count=c.id==='all'?assets.length:assets.filter(a=>a.collections.includes(c.id)).length;
 const b=node('button','collection-button');b.type='button';b.dataset.collection=c.id;b.append(node('span','',c.label),node('span','number',String(count)));b.addEventListener('click',()=>setCollection(c.id));byId('collection-list').append(b);
 if(c.id!=='all')selectOption(byId('collection'),c.id,`${c.label} (${count})`);
}
selectOption(byId('character'),'all','전체 캐릭터');for(const c of catalog.characters)if(assets.some(a=>a.characters.includes(c.id)))selectOption(byId('character'),c.id,c.label);
selectOption(byId('view'),'all','전체 구도');for(const [id,label] of Object.entries(catalog.view_labels))if(assets.some(a=>a.view===id))selectOption(byId('view'),id,label);
for(const [number,label] of [[catalog.counts.current,'최근 정리본'],[catalog.counts.history,'이전 버전'],[catalog.counts.reference,'참조 이미지'],[catalog.duplicate_paths,'중복 경로 연결']]){const p=node('div');p.append(node('strong','',String(number)),node('span','',label));byId('totals').append(p);}
for(const a of assets)a.search=[a.title,a.description,a.character_label,a.path,a.review_note,a.style,a.source_group_label,...(a.search_tags||[]),...a.aliases.map(p=>p.title+' '+p.path)].join(' ').toLocaleLowerCase();
function setCollection(id){
 if(id!=='all'&&!collections.has(id))return;
 state.collection=id;state.character='all';state.view='all';state.query='';
 byId('character').value='all';byId('view').value='all';byId('query').value='';
 if(['attachments','gc9refs','sp13refs'].includes(id))state.scope='reference';
 else if(id==='blondWarrior'||state.scope==='reference')state.scope='current';
 byId('collection').value=id;state.limit=24;
 const hash=id==='all'?'':'#'+id;if(location.hash!==hash)history.replaceState(null,'',location.href.split('#')[0]+hash);
 render();
}
function matching(){const terms=state.query.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);return assets.filter(a=>(state.scope==='all'||a.status===state.scope)&&(state.collection==='all'||a.collections.includes(state.collection))&&(state.character==='all'||a.characters.includes(state.character))&&(state.view==='all'||a.view===state.view)&&terms.every(t=>a.search.includes(t))).sort((a,b)=>state.sort==='version'?b.version-a.version:state.sort==='character'?a.character_label.localeCompare(b.character_label,'ko'):0);}
let filtered=[];
function openAsset(a){
 const img=byId('large');img.className=a.style.includes('픽셀')?'pixel':'';img.src=a.url;img.alt=a.title;img.width=a.width;img.height=a.height;
 byId('fit').setAttribute('aria-pressed','false');byId('viewer-title').textContent=a.title;byId('viewer-info').textContent=`${a.width} × ${a.height} px · ${a.transparentBackground?'실제 알파 투명':'배경 포함'} · 원본 100%`;byId('viewer-path').textContent=a.path;
 const links=byId('viewer-links');links.replaceChildren();const download=node('a','','원본 파일 저장');download.href=a.url;download.download=a.path.split('/').at(-1);links.append(download);for(const l of a.links){const link=node('a','',l.label);link.href=l.url;link.target='_blank';link.rel='noopener';links.append(link);}
 byId('alias-list').replaceChildren();for(const alias of a.aliases){const li=node('li'),link=node('a','',alias.path);link.href=alias.url;link.target='_blank';link.rel='noopener';li.append(link);byId('alias-list').append(li);}byId('alias-summary').textContent=`보관 경로 ${a.aliases.length}개`;byId('aliases').open=false;
 viewer.showModal();
}
function render(){
 filtered=matching();grid.replaceChildren();
 for(const a of filtered.slice(0,state.limit)){
  const card=node('article','card');card.dataset.id=a.id;card.dataset.collection=a.collection;card.dataset.status=a.status;
  const stage=node('button','stage');stage.type='button';stage.setAttribute('aria-label',a.title+' 원본 보기');const img=node('img',a.style.includes('픽셀')?'pixel':'');img.src=a.url;img.alt=a.title;img.loading='lazy';img.decoding='async';img.width=a.width;img.height=a.height;stage.append(img);stage.addEventListener('click',()=>openAsset(a));
  const body=node('div','card-body');body.append(node('div','character',a.character_label),node('h2','',a.title));const badges=node('div','badges');badges.append(node('span','badge '+a.status,scopeNames[a.status]));if(a.role==='created')badges.append(node('span','badge','v'+String(a.version).padStart(2,'0')));badges.append(node('span','badge',a.view_label));body.append(badges,node('div','meta',`${a.width} × ${a.height} · ${a.transparentBackground?'투명 배경':'배경 포함'}`));
  if(a.description)body.append(node('p','description',a.description));if(a.review_note)body.append(node('p','review-note',a.review_note));
  const actions=node('div','actions');const open=node('button','','원본 100%');open.type='button';open.addEventListener('click',()=>openAsset(a));const save=node('a','','저장');save.href=a.url;save.download=a.path.split('/').at(-1);actions.append(open,save);if(a.duplicate_count)actions.append(node('span','meta',`경로 ${a.aliases.length}개`));body.append(actions);card.append(stage,body);grid.append(card);
 }
 byId('empty').hidden=filtered.length>0;byId('more').hidden=filtered.length<=state.limit;byId('more').textContent=`더 보기 · 남은 ${Math.max(0,filtered.length-state.limit)}장`;
 byId('result-heading').textContent=(state.collection==='all'?scopeNames[state.scope]:collections.get(state.collection).label);
 byId('result-count').textContent=`${filtered.length}장 중 ${Math.min(filtered.length,state.limit)}장 표시 · ${scopeNames[state.scope]}`;
 for(const b of document.querySelectorAll('[data-scope]'))b.setAttribute('aria-pressed',String(b.dataset.scope===state.scope));for(const b of document.querySelectorAll('[data-collection]'))if(b.tagName==='BUTTON')b.setAttribute('aria-pressed',String(b.dataset.collection===state.collection));
}
byId('query').addEventListener('input',e=>{state.query=e.target.value;state.limit=24;render();});
for(const id of ['character','view','sort'])byId(id).addEventListener('change',e=>{state[id]=e.target.value;state.limit=24;render();});
byId('collection').addEventListener('change',e=>setCollection(e.target.value));
byId('more').addEventListener('click',()=>{state.limit+=24;render();});
byId('reset').addEventListener('click',()=>{Object.assign(state,{scope:'current',collection:'all',character:'all',view:'all',query:'',sort:'collection',limit:24});for(const id of ['collection','character','view'])byId(id).value='all';byId('sort').value='collection';byId('query').value='';setCollection('all');});
for(const b of document.querySelectorAll('[data-background]'))b.addEventListener('click',()=>{document.documentElement.style.setProperty('--stage',b.dataset.background);for(const other of document.querySelectorAll('[data-background]'))other.setAttribute('aria-pressed',String(other===b));});
byId('fit').addEventListener('click',e=>{const fit=byId('large').classList.toggle('fit');e.currentTarget.setAttribute('aria-pressed',String(fit));});byId('close').addEventListener('click',()=>viewer.close());viewer.addEventListener('click',e=>{if(e.target===viewer){const r=viewer.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)viewer.close();}});
addEventListener('hashchange',()=>{const id=location.hash.slice(1)||'all';if(id==='all'||collections.has(id))setCollection(id);});
const initialCollection=location.hash.slice(1);if(collections.has(initialCollection))setCollection(initialCollection);else render();
</script></body></html>
